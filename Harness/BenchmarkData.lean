namespace Harness.BenchmarkData
def header := "import GraphQL.Plan.SchemaEvidence\nopen GraphQL.Plan\nset_option maxRecDepth 30000\nset_option maxHeartbeats 16000000\n"
def small := "import Example.Tenant.Schema\nopen GraphQL.Plan Example.Tenant.Binding\ntheorem freshWellFormed : WellFormedSchema demoAst := by decide +kernel\ntheorem freshRepresents : Represents demoAst indexedSchema := by decide +kernel\n#print axioms freshWellFormed\n#print axioms freshRepresents\n"
def mixed := "import GraphQL.Plan.SchemaEvidence\nopen GraphQL.Plan\nset_option maxRecDepth 30000\nset_option maxHeartbeats 16000000\nabbrev ast : GraphQL.Schema := ⟨[\n ⟨\"Query\", .object, [⟨\"label\", .named \"String\" false, [⟨\"value\", .named \"String\" false⟩]⟩,\n  ⟨\"count\", .named \"Int\" true, []⟩, ⟨\"enabled\", .named \"Boolean\" true, []⟩,\n  ⟨\"items\", .list (.named \"Item\" true) false, []⟩], [], []⟩,\n ⟨\"Item\", .object, [⟨\"id\", .named \"ID\" true, []⟩,\n  ⟨\"children\", .list (.named \"Item\" false) true, []⟩], [], []⟩], \"Query\"⟩\ndef indexed : IndexedSchema ast := ⟨fun o => match o.val with\n | 0 => [⟨\"label\", .optional .string, .nullable .string⟩, ⟨\"count\", .unit, .int⟩,\n   ⟨\"enabled\", .unit, .boolean⟩, ⟨\"items\", .unit, .nullable (.list (.object 1))⟩]\n | _ => [⟨\"id\", .unit, .string⟩, ⟨\"children\", .unit, .list (.nullable (.object 1))⟩], 0, fun o i => if o.val = 0 ∧ i = 0 then [⟨\"value\", .named \"String\" false⟩] else []⟩\ntheorem freshWellFormed : WellFormedSchema ast := by decide +kernel\ntheorem freshRepresents : Represents ast indexed := by decide +kernel\n#print axioms freshWellFormed\n#print axioms freshRepresents\n"
end Harness.BenchmarkData
